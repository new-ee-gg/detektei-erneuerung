# Kontaktformular – Serverless Function /api/contact
# In Vercel unter Project → Settings → Environment Variables hinterlegen (Production + Preview).

# Empfänger der Anfragen (Pflicht)
MAIL_TO=info@sicherheitszentrale-muc.de
# Absenderadresse (muss zur Versanddomain passen; Standard: SMTP_USER)
MAIL_FROM=website@detektei-weltweit.de

# Variante A – SMTP (z. B. Microsoft 365, SMTP AUTH muss für das Postfach aktiviert sein)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=website@detektei-weltweit.de
SMTP_PASS=

# Variante B – Resend (https://resend.com), Domain detektei-weltweit.de dort verifizieren (SPF/DKIM)
# RESEND_API_KEY=

# Optional: Cloudflare Turnstile (Client-Widget muss dann in kontakt.html + CSP ergänzt werden)
# TURNSTILE_SECRET_KEY=

# Optional: erlaubte Origins (kommagetrennt). Standard: www.detektei-weltweit.de, detektei-weltweit.de, *.vercel.app, localhost
# ALLOWED_ORIGINS=

# Nur für lokale Tests: Mail wird nicht versendet, sondern in der Antwort zurückgegeben
# MAIL_TRANSPORT=stream
